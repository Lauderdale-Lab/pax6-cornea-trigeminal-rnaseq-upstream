#!/usr/bin/env python3
# Test stand-in for FastQC: writes <name>_fastqc.zip holding a fastqc_data.txt.
# FASTQC_STUB_ADAPTER=1 adds an adapter to the Overrepresented sequences module.
import os, sys, zipfile
args, out, files = sys.argv[1:], ".", []
if args and args[0] == "--version":
    print("FastQC v0.12.1"); sys.exit(0)
i = 0
while i < len(args):
    a = args[i]
    if a in ("-o", "-t"):
        if a == "-o": out = args[i + 1]
        i += 2; continue
    if not a.startswith("-"): files.append(a)
    i += 1
for f in files:
    base = os.path.basename(f)
    for ext in (".gz", ".fastq", ".fq"):
        if base.endswith(ext): base = base[: -len(ext)]
    data = ">>Overrepresented sequences\twarn\n#Sequence\tCount\tPercentage\tPossible Source\n"
    if os.environ.get("FASTQC_STUB_ADAPTER"):
        data += "AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC\t10\t0.1\tTruSeq Adapter, Index 1 (100% over 50bp)\n"
    data += ">>END_MODULE\n"
    with zipfile.ZipFile(os.path.join(out, base + "_fastqc.zip"), "w") as z:
        z.writestr(base + "_fastqc/fastqc_data.txt", data)
