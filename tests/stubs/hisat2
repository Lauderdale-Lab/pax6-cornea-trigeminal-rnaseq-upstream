#!/usr/bin/env bash
# Test stand-in for HISAT2: writes a summary file and a one-read SAM to stdout.
[[ "${1:-}" == --version ]] && { echo "/apps/eb/HISAT2/2.2.1/bin/hisat2-align-s version 2.2.1"; exit 0; }
while (( $# )); do
  case "$1" in --summary-file) sum="$2"; shift 2 ;; --known-splicesite-infile) ss="$2"; shift 2 ;; *) shift ;; esac
done
[[ -s "${ss:-}" ]] || { echo "stub hisat2: no splice-site file" >&2; exit 1; }
printf 'HISAT2 summary stats:\n\tTotal pairs: 1000\n\t\tAligned concordantly or discordantly 0 time: 30 (3.00%%)\n\t\tAligned concordantly 1 time: 900 (90.00%%)\n\tOverall alignment rate: 97.00%%\n' > "$sum"
printf '@SQ\tSN:chr1\tLN:1000\nr1\t0\tchr1\t1\t60\t4M\t*\t0\t0\tACGT\tIIII\n'
