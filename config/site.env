# Site settings for UGA Sapelo2. Sourced by every script.
# Everything here can be overridden by exporting the variable before a command.

# Project root on /work. data/, reference/ and archive/ live under it.
: "${PAX6_ROOT:=/work/jdllab/PAX6_RNAseq}"

# Where runs are processed. Scratch is fast and keeps trimmed reads and BAMs
# (roughly 15 GB per library) off the group's /work quota, but Sapelo2 purges
# files on scratch that go unused, so nothing there is permanent.
: "${PAX6_RUNS:=/scratch/${USER:-unknown}/PAX6_RNAseq/runs}"

# Where results are kept. Every count job copies its matrix, provenance and
# the run's QC and records here, on /work, as soon as it finishes.
# tools/keep_run.sh copies anything else (BAMs, full QC) on request.
: "${PAX6_KEEP:=$PAX6_ROOT/runs}"

# SLURM defaults passed by bin/pax6 on every sbatch call.
: "${PAX6_PARTITION:=batch}"
: "${PAX6_MAIL:=}"                 # e.g. export PAX6_MAIL=you@uga.edu for job e-mails
: "${PAX6_ARRAY_MAX:=8}"           # at most this many array tasks run at once
