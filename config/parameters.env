# Analysis parameters. These define the results: changing any of them means a
# new run, never an edit to an existing one. Copied into each run at creation.

# Trimmomatic (identical to the settings behind the published matrices)
TRIM_ILLUMINACLIP="2:30:10:2:True"
TRIM_STEPS="LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20 MINLEN:50"

# HISAT2
HISAT2_ARGS="--dta"

# featureCounts (identical to the published matrices; -s comes from datasets.tsv)
FC_ARGS="-t exon -g gene_id -O -M --primary -Q 10"
FC_PE_ARGS="-p --countReadPairs -B -C"

# Quality gates
MIN_ASSIGN_RATIO=70        # % Assigned/(Assigned+NoFeatures); below this, counting exits 3
STRAND_TEST_SAMPLES=3      # libraries per dataset used by the strand check
